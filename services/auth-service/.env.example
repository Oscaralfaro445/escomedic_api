# Servidor
PORT=4001
NODE_ENV=development

# Cookie
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGIN=http://localhost:3000

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=-
JWT_EXPIRES_IN=1h

# Generar JWT_SECRET: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"